# Deployment archive writes all site settings to root .env (mode 600).
COMPOSE_PROJECT_NAME=traffic_analyzer_prod
PLATFORM_IMAGE=traffic-analyzer-platform:RELEASE-arm64
CONSOLE_IMAGE=traffic-analyzer-console:RELEASE-arm64
DB_HOST=37.12.14.133
DB_PORT=5866
DB_NAME=ycx_prod
DB_SCHEMA=drone
DB_USER=sysdba
DB_SSLMODE=prefer
# Root Compose calls this ROAD9_PASSWORD; production uses it for ycx_prod, not a local DB.
ROAD9_PASSWORD=
KAFKA_BOOTSTRAP=37.12.14.66:9093,37.12.14.67:9093,37.12.14.68:9093,37.12.14.69:9093
KAFKA_SASL_USERNAME=xinchan
KAFKA_SASL_PASSWORD=
JWT_SECRET_KEY=
BOOTSTRAP_ADMIN_PASSWORD=
# First ./docker-compose up resolves the host IP into an explicit JSON allowlist.
PUBLIC_HOST=auto
CORS_ORIGINS=auto
CONSOLE_PORT=8009
ASSET_ROOT=../traffic-analyzer-assets
DATA_ROOT=../traffic-analyzer-data
PIPELINE_FRAME_STRIDE=3
ASCEND_DAVINCI_DEVICE=/dev/davinci0
ASCEND_DEVICE_ID=0
UAV_RTSP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Browser-visible MineMap SDK key; configured private archive fills this.
MINEMAP_DOMAIN=http://37.8.188.98:21009
MINEMAP_SOLUTION=17000
MINEMAP_KEY=
# Required syntactically by root Compose; not loaded by the MineMap provider.
AMAP_JS_API_KEY=not-used-minemap

# Explicit production exception: ordinary PostgreSQL tables until DBA enables TimescaleDB.
DB_TIMESCALE_REQUIRED=false
ROAD_FEATURES_ENABLED=false
YCX_METRICS_BACKEND=doris
# Set only to a DBA-confirmed road version when dim_data_version is unavailable.
YCX_ROAD_VERSION=
DORIS_MYSQL_HOST=37.12.11.127
DORIS_MYSQL_PORT=9030
DORIS_MYSQL_USER=
DORIS_MYSQL_PASSWORD=
DORIS_DATABASE=ycx_xc

# Optional explicit MineMap SDK/style/service endpoints; empty retains the site 2.1.0 defaults.
MINEMAP_SDK_BASE_URL=
MINEMAP_SERVICE_URL=
MINEMAP_SERVER_DOMAIN=
MINEMAP_STYLE_URL=
